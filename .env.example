# ==============================================================================
# SMART LOCKER KIOSK - TEMPLATE CONFIGURATION (.env.example)
# Copy this file to .env and adjust variables for your target machine.
# ==============================================================================

# 1. Backend API Endpoint
API_BASE_URL=http://localhost:5000/api

# 2. Hardware Kiosk Station Identity
LOCKER_STATION_ID=CMH-01
LOCKER_STATION_NAME=Central Mall Depot

# 3. Android Serial Port Hardware Config (RS485)
SERIAL_PORT=/dev/ttyS3
SERIAL_BAUD_RATE=9600
SERIAL_TIMEOUT_MS=3000

# 4. Kiosk Safety Timers (in seconds)
SESSION_IDLE_TIMEOUT=60
DOOR_OPEN_TIMEOUT=30

# 5. Customer Service & Support
SUPPORT_HOTLINE=(02) 8923-4567
